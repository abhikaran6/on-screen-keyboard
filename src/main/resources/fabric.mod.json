{
  "schemaVersion": 1,
  "id": "onscreenkeyboard",
  "version": "${version}",
  "name": "On-Screen QWERTY Keyboard",
  "description": "A floating three-page touch-friendly typing keyboard for Minecraft text fields.",
  "authors": [
    "Abhikaran"
  ],
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.onscreenkeyboard.OnScreenKeyboardClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "1.21.11",
    "fabric-api": "*",
    "java": ">=21"
  },
  "mixins": [
    "onscreenkeyboard.mixins.json"
  ]
}
